{
  "name": "@turbine-hall/turbine-cli",
  "version": "0.6.0",
  "description": "Turbine Hall CLI — governed human/AI software workflow",
  "type": "module",
  "bin": {
    "turbine": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "frameworks",
    "roles",
    "skills"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turbine-hall/turbine.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/turbine-hall/turbine#readme",
  "bugs": {
    "url": "https://github.com/turbine-hall/turbine/issues"
  },
  "scripts": {
    "copy-factory": "node ./scripts/copy-factory.mjs",
    "build": "tsc -p tsconfig.json && pnpm run copy-factory",
    "prepack": "pnpm run copy-factory",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@turbine-hall/turbine-adapter-git": "workspace:*",
    "@turbine-hall/turbine-adapter-github": "workspace:*",
    "@turbine-hall/turbine-adapter-jira": "workspace:*",
    "@turbine-hall/turbine-adapter-tests": "workspace:*",
    "@turbine-hall/turbine-contracts": "workspace:*",
    "@turbine-hall/turbine-core": "workspace:*",
    "@turbine-hall/turbine-evidence-contract": "workspace:*",
    "@turbine-hall/turbine-executor": "workspace:*",
    "@turbine-hall/turbine-lineage-impact": "workspace:*",
    "@turbine-hall/turbine-models": "workspace:*",
    "@turbine-hall/turbine-skills": "workspace:*",
    "@turbine-hall/turbine-storage-sqlite": "workspace:*",
    "@turbine-hall/turbine-tools": "workspace:*",
    "commander": "^15.1.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
