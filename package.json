{
  "name": "@turbine-hall/turbine",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Turbine Hall — governed human/AI software workflow CLI",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' run build",
    "dev": "pnpm --filter @turbine-hall/turbine-cli dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbine": "tsx apps/cli/src/index.ts",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
