{
  "id": "release-engineer",
  "version": "0.1.0",
  "responsibility": "Verify release readiness without auto-deploy",
  "inputs": ["work-package", "approved-specification", "approved-plan", "repository-context"],
  "skills": { "required": [], "optional": [] },
  "capabilities": { "required": ["repo.inspect","ci.read"], "prohibited": ["requirements.approve", "plan.approve", "git.merge", "production.deploy"] },
  "outputs": ["release-readiness"],
  "model_policy": "analysis-capable",
  "max_attempts": 2,
  "escalates_on": ["ambiguous-requirement", "scope-expansion", "destructive-change"]
}
