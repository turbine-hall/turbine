{
  "id": "code-reviewer",
  "version": "0.1.0",
  "responsibility": "Review diff vs spec",
  "inputs": ["work-package", "approved-specification", "approved-plan", "repository-context"],
  "skills": { "required": ["core/review-change"], "optional": [] },
  "capabilities": { "required": ["repo.read","git.diff"], "prohibited": ["requirements.approve", "plan.approve", "git.merge", "production.deploy"] },
  "outputs": ["review"],
  "model_policy": "analysis-capable",
  "max_attempts": 2,
  "escalates_on": ["ambiguous-requirement", "scope-expansion", "destructive-change"]
}
