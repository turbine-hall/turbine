{
  "id": "database-engineer",
  "version": "0.1.0",
  "responsibility": "Design/verify schema and data migration",
  "inputs": ["work-package", "approved-specification", "approved-plan", "repository-context"],
  "skills": { "required": ["core/plan-change","core/execute-code-change"], "optional": [] },
  "capabilities": { "required": ["repo.read","workspace.write"], "prohibited": ["requirements.approve", "plan.approve", "git.merge", "production.deploy"] },
  "outputs": ["plan","change-report"],
  "model_policy": "analysis-capable",
  "max_attempts": 2,
  "escalates_on": ["ambiguous-requirement", "scope-expansion", "destructive-change"]
}
