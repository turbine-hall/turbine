{
  "id": "e2e-sqa",
  "version": "0.1.0",
  "responsibility": "Verify end-to-end journeys",
  "inputs": ["work-package", "approved-specification", "approved-plan", "repository-context"],
  "skills": { "required": ["core/verify-acceptance"], "optional": [] },
  "capabilities": { "required": ["tests.run"], "prohibited": ["requirements.approve", "plan.approve", "git.merge", "production.deploy"] },
  "outputs": ["test-report"],
  "model_policy": "analysis-capable",
  "max_attempts": 2,
  "escalates_on": ["ambiguous-requirement", "scope-expansion", "destructive-change"]
}
